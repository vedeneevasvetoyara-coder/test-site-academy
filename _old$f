<script>
/* Данные палитр */
const BASE = [
 ["01","Молочный","#F5F2EC"],["02","Тёплый белый","#FAF7F2"],["03","Светло-серый","#EEF1F3"],
 ["04","Нежно-зелёный","#DCE7D2"],["05","Пудровый","#F3E4DC"],["06","Нежно-голубой","#D5E4EE"],
 ["07","Лавандовый","#E6E2F0"],["08","Песочный","#EFE6D5"],["09","Мятный","#9CC7A9"],
 ["10","Голубой","#6FA8C9"],["11","Оливковый","#6B7C3F"],["12","Горчичный","#C9A227"],
 ["13","Изумруд","#2E5E3A"],["14","Тёмно-зелёный","#1F4229"],["15","Синий","#1D5C8A"],
