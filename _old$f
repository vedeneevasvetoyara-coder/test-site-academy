 ["65","Сланцевый","slate-400","#94A3B8"],["66","Сланцевый","slate-600","#475569"]
];
const LIGHT = new Set(["01","02","03","04","05","06","07","08","09","25","37","39","41","43","45","47","49","61","63","65"]);
const ALL = [
 ...BASE.map(b=>({n:b[0],name:b[1],code:null,hex:b[2]})),
 ...TW.map(t=>({n:t[0],name:t[1],code:t[2],hex:t[3]}))
];
const BY_N = Object.fromEntries(ALL.map(c=>[c.n,c]));

const COMBOS = [
 {t:"Спокойный и надёжный", ns:["02","15"]},
 {t:"Свежесть и доверие", ns:["06","42"]},
 {t:"Тепло и уют", ns:["08","19"]},
 {t:"Современный яркий", ns:["49","52"]},
 {t:"Премиум и глубина", ns:["28","21"]},
 {t:"Нежность", ns:["05","25"]},
 {t:"Энергия и рост", ns:["39","40"]},
 {t:"Стиль и интрига", ns:["66","59"]}
];
const ROLE_NAMES = ["фон","кнопки","заголовок и карточки"];
const MAX_LINK = "https://max.ru/u/f9LHodD0cOKmZTJR2Hq6jo_UnEer7Ip-8JwHayHEPmbGhq7Ukyw1NXHAREg";

let chosen = []; /* до 3 номеров: [фон, кнопки, заголовок] */

const $ = id=>document.getElementById(id);
const lum = hex=>{
 const v=hex.replace("#","");
 const r=parseInt(v.slice(0,2),16),g=parseInt(v.slice(2,4),16),b=parseInt(v.slice(4,6),16);
 return (0.299*r+0.587*g+0.114*b)/255;
};
const textOn = hex=>lum(hex)>0.62?"#1B2A41":"#FFFFFF";

function toast(msg){
 const t=$("toast"); t.textContent=msg; t.classList.add("show");
 clearTimeout(t._h); t._h=setTimeout(()=>t.classList.remove("show"),2600);
}
function copy(text,msg){
 const done=()=>toast(msg);
 const fallback=()=>{
   const ta=document.createElement("textarea"); ta.value=text; ta.style.position="fixed"; ta.style.opacity="0";
   document.body.appendChild(ta); ta.select();
   try{document.execCommand("copy"); done();}catch(e){toast("Не удалось скопировать");}
   document.body.removeChild(ta);
 };
 if(navigator.clipboard&&navigator.clipboard.writeText){
   navigator.clipboard.writeText(text).then(done).catch(fallback);
 } else fallback();
}

/* --- рендер тюбиков --- */
function render(gridId,data,tw){
 const g=$(gridId);
 data.forEach((c,i)=>{
   const col = tw?{n:c[0],name:c[1],code:c[2],hex:c[3]}:{n:c[0],name:c[1],code:null,hex:c[2]};
   const b=document.createElement("button");
   b.type="button"; b.className="tube"+(LIGHT.has(col.n)?" txt-dark":"");
   b.dataset.n=col.n; b.dataset.search=(col.n+" "+col.name+" "+(col.code||"")+" "+col.hex).toLowerCase();
   b.setAttribute("aria-label","Цвет "+col.n+" "+col.name);
   b.innerHTML='<span class="tube-cap"></span>'+
     '<span class="tube-body" style="background:'+col.hex+'"></span>'+
     '<span class="tube-check">✓</span>'+
     '<span class="tube-name">'+col.name+'</span>'+
     '<span class="tube-num" title="Нажмите, чтобы скопировать код">'+col.n+(col.code?" · "+col.code:"")+'</span>';
   b.addEventListener("click",e=>{
     if(e.target.classList.contains("tube-num")){
       copy(col.hex,"Скопировано: "+col.hex);
       return;
     }
     pick(col.n);
   });
   g.appendChild(b);
 });
}
render("grid1",BASE,false);
render("grid2",TW,true);

/* поиск */
[["q1","grid1"],["q2","grid2"]].forEach(([q,g])=>{
 $(q).addEventListener("input",e=>{
   const v=e.target.value.trim().toLowerCase();
   document.querySelectorAll("#"+g+" .tube").forEach(s=>{
     s.classList.toggle("hide",v&&!s.dataset.search.includes(v));
   });
 });
});

/* --- выбор: порядок фон → кнопки → заголовок --- */
function pick(n){
 const i=chosen.indexOf(n);
 if(i>=0){ chosen.splice(i,1); }
 else{
   if(chosen.length>=3){ toast("Выбраны все три цвета. Чтобы заменить — сначала уберите один (нажмите на него ещё раз)."); return; }
   chosen.push(n);
 }
 sync();
}
function sync(){
 document.querySelectorAll(".tube").forEach(s=>s.classList.toggle("sel",chosen.includes(s.dataset.n)));
 renderChips(); paint(); renderHint(); renderMessage();
}
function renderChips(){
 const box=$("chips"); box.innerHTML="";
 chosen.forEach((n,i)=>{
   const c=BY_N[n];
   const chip=document.createElement("span");
   chip.className="chip";
   chip.innerHTML='<i style="background:'+c.hex+'"></i>'+ROLE_NAMES[i]+': №'+n+' '+c.name+
     '<button class="chip-x" aria-label="Убрать цвет '+n+'">✕</button>';
   chip.querySelector(".chip-x").addEventListener("click",e=>{e.stopPropagation();pick(n);});
   box.appendChild(chip);
 });
 for(let i=chosen.length;i<3;i++){
   const ph=document.createElement("span");
   ph.className="chip empty"; ph.textContent=ROLE_NAMES[i]+" — выберите";
   box.appendChild(ph);
 }
}
function renderHint(){
 const hint=$("stepHint"), txt=$("stepText");
 if(chosen.length<3){
   txt.textContent="Шаг "+(chosen.length+1)+" из 3 — сейчас клик красит: "+ROLE_NAMES[chosen.length];
   hint.classList.remove("done");
 }else{
   txt.textContent="Всё выбрано! Проверьте сообщение ниже и нажмите «Отправить»";
   hint.classList.add("done");
 }
}
function paint(flash){
 const pv=$("preview");
 const cBg=chosen[0]?BY_N[chosen[0]]:null;
 const cBtn=chosen[1]?BY_N[chosen[1]]:null;
 cHead=chosen[2]?BY_N[chosen[2]]:null;

 const bg=cBg?cBg.hex:"#EEF1F5";
 pv.style.background=bg;
 const ink=textOn(bg);
 $("mini").style.color=ink;

 const acc=cBtn?cBtn.hex:"#5E6B7C";
 $("mbtn1").style.background=acc;
 $("mbtn1").style.color=cBtn?textOn(cBtn.hex):"#fff";
 $("mtitle").style.color=cHead?cHead.hex:ink;
 $("mdot").style.background=acc;
 $("blob1").style.background=cBg?cBg.hex:"#FFE600";
 $("blob2").style.background=cBtn?cBtn.hex:"#12BA6C";

 /* карточки — цвет заголовка, полоски — цвет кнопок */
 const cards=[[ $("mcard1"),$("mbar1")],[$("mcard2"),$("mbar2")],[$("mcard3"),$("mbar3")]];
 cards.forEach(([card,bar])=>{
   if(cHead){
     card.style.background=cHead.hex;
     card.style.color=textOn(cHead.hex);
   }else{
     card.style.background=(lum(bg)>0.75)?"rgba(27,42,65,.06)":"rgba(255,255,255,.12)";
     card.style.color=ink;
   }
   bar.style.background=acc;
 });
 ["rt1","rt2","rt3"].forEach((id,i)=>$(id).classList.toggle("off",!chosen[i]));
 if(flash){ pv.classList.remove("flash"); void pv.offsetWidth; pv.classList.add("flash"); }
}
let cHead=null;

/* --- финальное сообщение: анкета + цвета --- */
function colorsLine(){
 if(!chosen.length) return "";
 const parts=chosen.map((n,i)=>ROLE_NAMES[i]+" — №"+n+" "+BY_N[n].name+" ("+BY_N[n].hex+")");
 return "Цвета сайта: "+parts.join(", ");
}
function renderMessage(){
 let base="";
 try{ base=localStorage.getItem("sv-anketa-text")||""; }catch(e){}
 const col=colorsLine();
 let msg="";
 if(base&&col) msg=base+"\n"+col;
 else if(base) msg=base+"\nЦвета сайта: пока не выбраны (выберите тюбики выше)";
 else if(col) msg="Здравствуйте, Светлана! Хочу обсудить сайт.\n"+col;
 else msg="Здравствуйте, Светлана! Хочу обсудить сайт.";
 $("msgPreview").textContent=msg;
 $("tgLink").href="https://t.me/Website_bystro?text="+encodeURIComponent(msg);
 $("finalHint").textContent = base
   ? "Сюда автоматически добавились Ваши ответы на вопросы и выбранные цвета. Если всё верно — отправьте одним нажатием."
   : "Цвета добавлены в сообщение. А если сначала ответить на 5 вопросов на главной странице — они тоже попадут сюда автоматически.";
}
$("maxLink").addEventListener("click",()=>{
 copy($("msgPreview").textContent,"Текст скопирован — вставьте его в чат Макс");
});
$("btnCopyMsg").addEventListener("click",()=>{
 copy($("msgPreview").textContent,"Текст скопирован — вставьте его в сообщение");
});

/* кнопки */
$("btnClear").addEventListener("click",()=>{chosen=[];sync();toast("Выбор сброшен");});
$("btnRandom").addEventListener("click",()=>{
 let k=0;
 const iv=setInterval(()=>{
   chosen=[ALL[Math.floor(Math.random()*ALL.length)].n,ALL[Math.floor(Math.random()*ALL.length)].n];
   sync();
   if(++k>=7){
     clearInterval(iv);
     const a=ALL[Math.floor(Math.random()*ALL.length)];
     let b=ALL[Math.floor(Math.random()*ALL.length)];
     while(b.n===a.n) b=ALL[Math.floor(Math.random()*ALL.length)];
     chosen=[a.n,b.n];
     if(Math.random()<0.4){
       const lights=["01","02","03","05","06","08"];
       chosen.push(lights[Math.floor(Math.random()*lights.length)]);
     }
     sync(); paint(true);
   }
 },110);
});

/* готовые сочетания */
const cbox=$("combos");
COMBOS.forEach(c=>{
 const cols=c.ns.map(n=>BY_N[n].hex);
 const b=document.createElement("button");
 b.type="button"; b.className="combo-card";
 b.innerHTML="<b>"+c.t+"</b><span class='combo-strip'>"+cols.map(h=>"<i style='background:"+h+"'></i>").join("")+"</span>"+
   "<small>"+c.ns.map(n=>"№"+n).join(" + ")+" · нажать и посмотреть</small>";
 b.addEventListener("click",()=>{chosen=[...c.ns];sync();paint(true);$("preview").scrollIntoView({behavior:"smooth",block:"center"});});
 cbox.appendChild(b);
});

renderChips(); paint(); renderHint(); renderMessage();
</script>

