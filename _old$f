<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Выбор цветов сайта — Светлана, сайты для малого бизнеса</title>
<meta name="description" content="Выберите цвета будущего сайта: нажмите на краски — макет перекрасится сразу. Первый клик — фон, второй — кнопки, третий — заголовок.">
<link rel="stylesheet" href="fonts.css">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 44 44'%3E%3Cpath d='M6 40V22a16 16 0 0 1 32 0v18z' fill='%23fff' stroke='%231B2A41' stroke-width='3' stroke-linejoin='round'/%3E%3Ccircle cx='22' cy='26' r='6' fill='%23FFE600' stroke='%231B2A41' stroke-width='2.4'/%3E%3Cpath d='M6 40h32' stroke='%231B2A41' stroke-width='3' stroke-linecap='round'/%3E%3C/svg%3E">
<style>
:root{
  --lemon:#FFE600; --mint:#12BA6C; --ink:#1B2A41; --muted:#56627A;
  --panel:#EEF1F5; --slate:#5E6B7C; --bg:#FFFFFF;
  --f-head:"Unbounded","Arial Black",sans-serif; --f-text:"Onest","Segoe UI",system-ui,sans-serif; --f-name:"Yeseva One",Georgia,serif;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.65 var(--f-text)}
h1,h2,h3{margin:0;text-wrap:balance;font-family:var(--f-head);line-height:1.12}
p{margin:0}
a{color:inherit}
button{font-family:inherit}
:focus-visible{outline:3px solid var(--ink);outline-offset:4px}
.in{max-width:1180px;margin:0 auto;padding-left:max(20px,env(safe-area-inset-left,0px));padding-right:max(20px,env(safe-area-inset-right,0px))}

/* шапка */
header{padding-block:10px}
header .in{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none}
.logo span{font:400 28px var(--f-name)}
.top-actions{display:flex;align-items:center;gap:10px}
.phone-top{display:inline-flex;align-items:center;gap:8px;font:700 15px var(--f-text);text-decoration:none}
.phone-top svg{width:20px;height:20px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font:700 15px/1 var(--f-text);padding:16px 24px;border-radius:999px;text-decoration:none;background:var(--slate);color:#fff;transition:transform .15s, box-shadow .15s;border:none;cursor:pointer}
.btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(27,42,65,.18)}
.btn.mint{background:var(--mint)}
.btn.lemon{background:var(--lemon);color:var(--ink)}

/* первый экран */
.hero{padding:16px 0 16px;background:linear-gradient(180deg,#FFF 0%,var(--panel) 100%)}
.hero .in{display:grid;grid-template-columns:1fr;gap:14px;justify-items:center;text-align:center}
.kicker{display:inline-flex;align-items:center;gap:8px;font:700 12px var(--f-text);letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.kicker::before{content:"";width:26px;height:3px;border-radius:2px;background:var(--lemon)}
.hero h1{font-size:clamp(24px,3vw,36px);font-weight:800;margin-bottom:10px;max-width:30ch}
.hero .lead{font-size:16.5px;color:var(--muted);max-width:62ch}
.hero .lead b{color:var(--ink)}
.back-link{font:600 15px var(--f-text);color:var(--muted);text-decoration:underline;text-underline-offset:3px}

/* макет рядом с красками: слева макет (липнет при скролле), справа краски */
.work{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,8fr);gap:24px;width:100%;align-items:start}
.stage{display:grid;gap:14px;justify-items:center;width:100%;position:sticky;top:16px}
.work .pals{padding:0}
.work .pal{margin-top:26px}
.work .pal:first-child{margin-top:0}
@media(max-width:1023px){
  .work{grid-template-columns:1fr}
  .stage{position:static}
}
.preview{position:relative;width:min(760px,100%);border-radius:22px;overflow:hidden;box-shadow:0 24px 60px rgba(27,42,65,.16);border:1px solid rgba(27,42,65,.08);transition:background .8s ease;background:#EEF1F5}
.blob{position:absolute;border-radius:50%;filter:blur(46px);opacity:.45;transition:background 1s ease;animation:drift 14s ease-in-out infinite alternate;pointer-events:none}
.blob.b1{width:240px;height:240px;top:-70px;right:-60px}
.blob.b2{width:200px;height:200px;bottom:-80px;left:-50px;animation-delay:-7s}
@keyframes drift{from{transform:translate(0,0) scale(1)}to{transform:translate(46px,30px) scale(1.15)}}
.mini{position:relative;display:grid;gap:10px;padding:20px 22px 24px;min-height:250px;align-content:start;transition:color .6s ease;text-align:left}
.mini-nav{display:flex;align-items:center;justify-content:space-between;font-size:12.5px;font-weight:600}
.mini-nav .m-logo{display:flex;align-items:center;gap:7px}
.mini-nav .m-dot{width:10px;height:10px;border-radius:50%;transition:background .6s ease}
.mini-nav .m-links{display:flex;gap:12px;opacity:.75}
.mini h3.m-title{font-size:clamp(19px,2.4vw,26px);font-weight:800;transition:color .6s ease;max-width:22ch}
.mini .m-text{font-size:13.5px;line-height:1.55;opacity:.8;max-width:48ch;transition:color .6s ease}
.mini .m-btns{display:flex;gap:10px;flex-wrap:wrap;margin-top:4px}
.m-btn{font:700 13px var(--f-text);padding:12px 20px;border-radius:999px;transition:background .6s ease,color .6s ease}
.m-btn.ghost{border:1.5px solid currentColor;opacity:.85}
.mini .m-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:10px}
.m-card{border-radius:14px;padding:12px 12px 14px;font-size:11px;line-height:1.45;transition:background .6s ease,color .6s ease}
.m-card b{display:block;font-size:12px;margin-bottom:4px}
.m-card .bar{height:5px;border-radius:3px;margin-top:8px;transition:background .6s ease;opacity:.85}
.roles{position:absolute;inset:auto 14px 12px;display:flex;gap:8px;justify-content:flex-end;pointer-events:none;flex-wrap:wrap}
.role-tag{font:700 11px var(--f-text);padding:6px 11px;border-radius:999px;background:rgba(255,255,255,.92);color:var(--ink);box-shadow:0 4px 14px rgba(27,42,65,.14);transition:opacity .4s ease, transform .4s ease}
.role-tag.off{opacity:0;transform:translateY(6px)}
.flash{animation:flash .45s ease}
@keyframes flash{0%{filter:saturate(2) brightness(1.12)}100%{filter:none}}

/* подсказка шага */
.step-hint{display:inline-flex;align-items:center;gap:10px;font:700 15px var(--f-text);background:#fff;border:1.5px solid rgba(27,42,65,.12);border-radius:999px;padding:11px 20px;box-shadow:0 8px 20px rgba(27,42,65,.08)}
.step-hint i{width:14px;height:14px;border-radius:50%;background:var(--lemon);border:2px solid var(--ink);flex:none}
.step-hint.done i{background:var(--mint)}

/* тюбики */
.pals{padding:30px 0 10px}
.pal{margin-top:12px}
.pal-head{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-bottom:0}
.pal-head h2{font-size:clamp(17px,2vw,22px);font-weight:800}
.pal-head p{color:var(--muted);font-size:13px}
.search{margin-left:auto;display:flex;align-items:center;gap:8px;background:var(--panel);border-radius:999px;padding:6px 14px;min-width:180px}
.search svg{width:17px;height:17px;opacity:.55;flex:0 0 auto}
.search input{border:none;background:none;font:600 15px var(--f-text);color:var(--ink);width:100%;outline:none}
.tubes{display:grid;grid-template-columns:repeat(auto-fill,minmax(46px,1fr));gap:6px 4px;margin-top:8px}
.tube{position:relative;background:none;border:none;padding:2px 1px 0;cursor:pointer;text-align:center}
.tube-cap{display:block;height:6px;margin:0 16%;background:linear-gradient(180deg,#d3d8de 0%,#a9b0ba 60%,#8f97a3 100%);border-radius:2px 2px 1px 1px;position:relative;transition:transform .18s ease}
.tube-cap::after{content:"";position:absolute;inset:2px 12% auto;height:2px;background:rgba(255,255,255,.55);border-radius:2px}
.tube-body{display:block;height:26px;border-radius:5px 5px 8px 8px;box-shadow:inset 0 -6px 8px rgba(0,0,0,.16), inset 0 4px 8px rgba(255,255,255,.28), 0 2px 4px rgba(27,42,65,.12);position:relative;transition:transform .18s ease, box-shadow .18s ease}
.tube-body::after{content:"";position:absolute;top:4px;bottom:7px;left:4px;width:4px;border-radius:4px;background:linear-gradient(180deg,rgba(255,255,255,.5),rgba(255,255,255,.06))}
.tube-check{position:absolute;top:7px;left:50%;transform:translateX(-50%) scale(.4);width:18px;height:18px;border-radius:50%;background:#fff;color:var(--ink);display:grid;place-items:center;font:800 9px var(--f-text);opacity:0;transition:opacity .2s, transform .25s cubic-bezier(.34,1.56,.64,1);box-shadow:0 4px 10px rgba(27,42,65,.25);pointer-events:none}
.tube-name{display:block;font:700 9px/1.1 var(--f-text);margin-top:3px;color:var(--ink)}
.tube-num{display:block;font:700 8.5px/1.1 var(--f-text);color:var(--muted);margin-top:1px;letter-spacing:0;white-space:nowrap}
.tube:hover .tube-body{transform:translateY(-4px);box-shadow:inset 0 -10px 16px rgba(0,0,0,.16), inset 0 8px 12px rgba(255,255,255,.28), 0 12px 22px rgba(27,42,65,.2)}
.tube:hover .tube-cap{transform:translateY(-4px)}
.tube.sel .tube-check{opacity:1;transform:translateX(-50%) scale(1)}
.tube.sel .tube-body{box-shadow:inset 0 -10px 16px rgba(0,0,0,.16), inset 0 8px 12px rgba(255,255,255,.28), 0 0 0 3px #fff, 0 0 0 5.5px var(--ink)}
.tube.hide{display:none}
.tube.txt-dark .tube-name{color:#1B2A41}
.hint{font-size:13px;color:var(--muted);margin-top:12px}

/* выбранные цвета */
.choice{margin-top:22px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;justify-content:center}
.choice-label{font:700 14px var(--f-text);color:var(--muted)}
.chips{display:flex;gap:10px;flex-wrap:wrap}
.chip{display:inline-flex;align-items:center;gap:9px;font:700 14px var(--f-text);padding:9px 16px 9px 10px;border-radius:999px;border:1.5px solid rgba(27,42,65,.15);background:#fff;cursor:pointer}
.chip i{width:22px;height:22px;border-radius:50%;display:block;box-shadow:inset 0 0 0 2px rgba(255,255,255,.55)}
.chip.empty{border-style:dashed;color:var(--muted);background:transparent;cursor:default}
.chip-x{border:none;background:none;font:700 13px var(--f-text);color:var(--muted);cursor:pointer;padding:2px 2px 0 0}
.chip-x:hover{color:#E0144C}

/* сочетания — отдельный экран */
.combos{padding:60px 0;min-height:100dvh;display:grid;align-content:center}
.combo-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px;margin-top:16px}
.combo-card{border:1.5px solid rgba(27,42,65,.12);border-radius:18px;padding:18px;background:#fff;cursor:pointer;text-align:left;transition:transform .15s, box-shadow .15s}
.combo-card:hover{transform:translateY(-3px);box-shadow:0 12px 26px rgba(27,42,65,.12)}
.combo-card b{display:block;font:700 15px var(--f-text);margin-bottom:10px}
.combo-strip{display:flex;height:44px;border-radius:10px;overflow:hidden}
.combo-strip i{flex:1;transition:flex .3s ease}
.combo-card:hover .combo-strip i{flex:1.25}
.combo-strip i:first-child{flex:1.6}
.combo-card small{display:block;color:var(--muted);margin-top:8px;font-size:12.5px}

/* финал: сообщение — отдельный экран */
.final{padding:40px 0;min-height:100dvh;display:grid;align-content:center;background:var(--ink);color:#fff}
.final .in{display:grid;gap:18px;justify-items:center;text-align:center}
.final h2{font-size:clamp(21px,2.6vw,30px);font-weight:800}
.final p{color:#C9D0DA;max-width:60ch}
.msg-preview{width:min(680px,100%);text-align:left;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.16);border-radius:16px;padding:18px 20px;font:500 14.5px/1.6 var(--f-text);color:#EDF1F6;white-space:pre-wrap;overflow-wrap:anywhere}
.msg-preview b{color:#fff}
.final .row{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-top:4px}
.btn.big{padding:19px 30px;font-size:16px}
.copy-note{font-size:13.5px;color:#C9D0DA}
footer{padding:22px 0;color:var(--muted);font-size:14px}
footer .in{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
footer a{text-decoration:none}
footer a:hover{text-decoration:underline}

/* тост */
.toast{position:fixed;left:50%;bottom:26px;transform:translate(-50%,80px);background:var(--ink);color:#fff;font:600 14.5px var(--f-text);padding:14px 22px;border-radius:14px;box-shadow:0 14px 34px rgba(27,42,65,.35);opacity:0;transition:transform .35s cubic-bezier(.34,1.56,.64,1),opacity .3s;z-index:50;pointer-events:none;max-width:min(92vw,480px);text-align:center}
.toast.show{transform:translate(-50%,0);opacity:1}

@media(max-width:700px){
  body{font-size:16px}
  .phone-top span{display:none}
  .hero{padding-top:26px}
  .mini{padding:20px 18px 28px}
  .mini .m-cards{grid-template-columns:1fr 1fr}
  .mini-nav .m-links{display:none}
  .tubes{grid-template-columns:repeat(auto-fill,minmax(62px,1fr));gap:12px 4px}
  .tube-body{height:42px}
  .tube-check{top:14px}
  .search{margin-left:0;width:100%}
  .msg-preview{font-size:13.5px}
}
</style>
</head>
